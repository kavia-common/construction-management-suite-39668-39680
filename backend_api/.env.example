# Backend API environment variables

# App
ENV=development
CORS_ALLOW_ORIGINS=*

# Supabase (required for auth endpoints to be live)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Database (provided by construction_management_db dependency)
CONSTRUCTION_DB_URL=
CONSTRUCTION_DB_USER=
CONSTRUCTION_DB_PASSWORD=
CONSTRUCTION_DB_NAME=
CONSTRUCTION_DB_PORT=
CONSTRUCTION_DB_DRIVER=postgresql

# Plaid integration
# Obtain credentials from https://dashboard.plaid.com/
PLAID_CLIENT_ID=
PLAID_SECRET=
# Optional, defaults to sandbox if not provided: sandbox | development | production
PLAID_ENV=sandbox
# Optional host override (advanced); if unset derived from PLAID_ENV
PLAID_HOST=
APP_NAME=Construction Management Suite
