# Backend API environment example

# CORS
CORS_ALLOW_ORIGINS=http://localhost:3000

# Supabase (optional for auth)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Plaid configuration (preferred backend variable names)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# Optional explicit host override (advanced)
# PLAID_HOST=https://sandbox.plaid.com

# App name shown in Link UI
APP_NAME=Construction Management Suite

# Note: For environments that only provide frontend-style variables,
# the backend will also read these as fallback:
# REACT_APP_PLAID_CLIENT_ID=
# REACT_APP_PLAID_SECRET=
# REACT_APP_PLAID_ENV=sandbox
